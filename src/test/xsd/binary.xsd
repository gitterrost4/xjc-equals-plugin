<?xml version="1.0" encoding="UTF-8"?>
<xs:schema targetNamespace="http://a.b.c.com/e" elementFormDefault="qualified"
           xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="http://a.b.c.com/e">
    <xs:element name="binaryModel">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="inlineBinary" type="xs:base64Binary" minOccurs="0"/>
                <xs:element name="inlineHex" type="xs:hexBinary" minOccurs="0"/>
                <xs:element name="name" type="xs:string" minOccurs="0"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>
