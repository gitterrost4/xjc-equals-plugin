<?xml version="1.0" encoding="UTF-8"?>
<!-- Makes the generated classes serializable, so that they carry a static serialVersionUID field and the
     selftest covers the handling of static fields in hashCode() and equals(). -->
<jaxb:bindings xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb" version="3.0">
    <jaxb:globalBindings>
        <jaxb:serializable uid="1"/>
    </jaxb:globalBindings>
</jaxb:bindings>
